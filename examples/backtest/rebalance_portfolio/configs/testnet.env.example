# BINANCE_TESTNET_API_SECRET=replace_with_your_private_key

# Option B (recommended): point to an ED25519 private key file
BINANCE_TESTNET_API_SECRET_FILE=examples/backtest/rebalance_portfolio/configs/binance_testnet_ed25519.key
